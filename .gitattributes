# 윈도우(CRLF)와 맥/Docker(LF)를 같이 쓰기 위한 줄바꿈 규칙
# 저장소에는 LF 로 저장하고, 각 컴퓨터에서 꺼낼 때 맞게 바꾼다.
* text=auto

# 리눅스 컨테이너에서 실행되는 파일은 항상 LF
*.sh   text eol=lf
compose.yaml text eol=lf
Dockerfile   text eol=lf

# 윈도우 전용 스크립트는 항상 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 바이너리
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.jar  binary
