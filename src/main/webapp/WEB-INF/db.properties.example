# 이 파일을 같은 폴더에 db.properties 로 복사해서 값을 채운다.
# db.properties 는 git 에 올리지 않는다(.gitignore). 컴퓨터마다 따로 둔다.
#
# 윈도우(Oracle 직접 설치): db.url=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# 맥북(Docker 컨테이너)   : db.url=jdbc:oracle:thin:@//oracle:1521/FREEPDB1
db.driver=oracle.jdbc.OracleDriver
db.url=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
db.user=PICKUP
db.password=
